# ── Secrets (never commit) ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*-key.*
*-key
*api-key*
*secret*
*credentials*
*.rtf

# ── Generated drift monitor outputs ───────────────────────────────────────────
# By default ignore new evidence/report/summary files generated by a fresh run.
evidence/
drift_report*.html
drift_summary*.md
baseline_v*_approved_*.json
baseline_v*_summary.txt

# Explicitly KEEP the v1.0 demo artifacts so a fresh clone has a working
# baseline + sample outputs to look at before running anything.
!evidence/
!evidence/.gitkeep
!evidence/drift_evidence_2026-06-01_stable.json
!evidence/drift_evidence_2026-06-01_critical.json
!drift_report_stable.html
!drift_report_critical.html
!drift_summary_stable.md
!drift_summary_critical.md
!baseline_v1.0_approved_2026-01-15.json
!baseline_v1.0_summary.txt

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Editors / OS ──────────────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# ── HuggingFace / model caches ────────────────────────────────────────────────
*.bin
*.safetensors
*.onnx
