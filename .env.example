# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# (The .gitignore already excludes it.)

# Required only if you want the LLM judge step (drift_test_simple.py step 5).
# The statistical drift portion (steps 1-4) runs fully without a key — use
# --skip-judge to demo the pipeline with no API key.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# Optional — override the default judge model (claude-sonnet-4-6).
# ANTHROPIC_JUDGE_MODEL=claude-sonnet-4-6
